# URL de l'API utilisée par le proxy Next.js. En Docker, utiliser le nom du service API.
API_URL=http://127.0.0.1:3333

# Hôtes autorisés à charger les ressources de développement Next.js, séparés par des virgules.
# Exemple pour un test depuis le réseau local : ALLOWED_DEV_ORIGINS=192.168.1.48
ALLOWED_DEV_ORIGINS=
