{
  "name": "la-cabane-du-merle",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "24.0.0"
  },
  "pnpm": {
    "overrides": {
      "react-native": "0.79.5"
    }
  },
  "scripts": {
    "openapi:check": "redocly lint apps/api/openapi/v1.yaml",
    "openapi:generate": "pnpm openapi:check && openapi-typescript apps/api/openapi/v1.yaml --output packages/api-client/src/index.ts",
    "openapi:verify": "pnpm openapi:check && openapi-typescript apps/api/openapi/v1.yaml --output /tmp/la-cabane-du-merle-openapi.ts && cmp -s packages/api-client/src/index.ts /tmp/la-cabane-du-merle-openapi.ts && rm /tmp/la-cabane-du-merle-openapi.ts",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "node tools/check-source.mjs",
    "boundaries": "node tools/check-boundaries.mjs",
    "cycles": "node tools/check-cycles.mjs",
    "test": "pnpm openapi:verify && node --test packages/testing/tests/*.test.mjs",
    "build": "pnpm --recursive --if-present run build"
  },
  "devDependencies": {
    "@redocly/cli": "2.12.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.8.3"
  }
}
