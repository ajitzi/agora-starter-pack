{
  "name": "la-cabane-du-merle",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "24.0.0"
  },
  "pnpm": {
    "overrides": {
      "react-native": "0.79.5"
    }
  },
  "scripts": {
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint": "node tools/check-source.mjs",
    "boundaries": "node tools/check-boundaries.mjs",
    "cycles": "node tools/check-cycles.mjs",
    "test": "node --test packages/testing/tests/*.test.mjs",
    "build": "pnpm --recursive --if-present run build"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
